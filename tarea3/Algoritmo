5. NAVEGABILIDAD
    obj = instanciar EventosBotones()
    llamar a obj.setVentana1() // Construye ventana principal y sus eventos
    llamar a obj.setVentana2() // Construye ventana secundaria y sus eventos
    llamar a obj.mostrarVentana(1) // Ejecuta y muestra la primera ventana
    
5.1 setBotones()
    si (boton b1 es presionado) entonces
        llamar a mostrarVentana(2)
    terminar si
    si (boton b2 es presionado) entonces
        llamar a cerrarVentana(2)
    terminar si

5.2 Eventos de Cierre (X) de las Ventanas
    si (botonExit de v1 es presionado) entonces
        llamar a cerrarVentana(1)
    terminar si
    si (botonExit de v2 es presionado) entonces
        llamar a cerrarVentana(2)
    terminar si

5.3 mostrarVentana(v)
    segun (v) hacer
        caso 1 -> hacer visible v1 (setVisible(true))
        caso 2 -> hacer visible v2 (setVisible(true))
    terminar segun

5.4 cerrarVentana(ventana)
    segun (ventana) hacer
        caso 1 -> llamar a confirmacion(v1)
        caso 2 -> llamar a cerrar(v2)
    terminar segun

5.5 confirmacion(v)
    si (v no es nulo y es visible) entonces
        Escribir("¿Desea salir del programa?")
        respuesta = ?
        si (respuesta == "Si") entonces
            llamar a cerrar(v) // libera recursos
            Finalizar programa (System.exit(0))
        terminar si
    terminar si

5.6 cerrar(v)
    si (v no es nulo) entonces
        llamar a v.setVisible(false)
        llamar a v.dispose() // libera recursos fisicos de la ventana
    terminar si